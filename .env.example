# Copy to .env and fill in secrets. See PLAN.md / plan_recorrected.md for details.

# --- LLM ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
LLM_TIMEOUT_SECONDS=20

# --- Embeddings ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Reranker ---
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_THRESHOLD=0.0

# --- Retrieval pipeline ---
TOP_K_WIDE=25
TOP_K=5
HYBRID_ALPHA=0.5
QUERY_EXPANSION_VARIANTS=2
ENABLE_QUERY_EXPANSION=true
SIMILARITY_THRESHOLD=0.35

# --- Chunking ---
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# --- Weaviate ---
# Weaviate Cloud (WCD): use the full https:// REST endpoint URL and an API key.
# For local self-hosted Weaviate (docker-compose), use http://weaviate:8080 and leave the key blank.
WEAVIATE_URL=https://your-cluster-id.weaviate.cloud
WEAVIATE_API_KEY=

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://raguser:${POSTGRES_PASSWORD}@postgres:5432/ragdb

# --- Auth ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# --- Memory ---
LONG_TERM_SUMMARY_EVERY_N_TURNS=6

# --- Service ---
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_BASE_URL=http://backend:8000
